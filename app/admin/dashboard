'use client';

import { useState } from 'react';
import { supabase } from '@/lib/supabase';

export default function AdminPage() {
  const [tab, setTab] = useState<'dhamma' | 'events'>('dhamma');
  const [msg, setMsg] = useState('');
  const [date, setDate] = useState('');
  const [title, setTitle] = useState('');

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (tab === 'dhamma') {
      await supabase.from('dhamma_thoughts').insert([{ message: msg, published_date: date }]);
    } else {
      await supabase.from('events').insert([{ title, description: msg, event_date: date }]);
    }
    alert('සාර්ථකව එකතු කරන ලදී!');
    setMsg(''); setTitle(''); setDate('');
  };

  return (
    <main className="max-w-2xl mx-auto px-4 py-10">
      <h1 className="text-2xl font-bold mb-6">ඇඩ්මින් පාලක පුවරුව</h1>
      <div className="flex gap-4 mb-6">
        <button type="button" onClick={() => setTab('dhamma')} className={`px-4 py-2 rounded ${tab === 'dhamma' ? 'bg-orange-600 text-white' : 'bg-slate-200'}`}>දහම් ചിන්තාව</button>
        <button type="button" onClick={() => setTab('events')} className={`px-4 py-2 rounded ${tab === 'events' ? 'bg-orange-600 text-white' : 'bg-slate-200'}`}>පින්කම්/උත්සව</button>
      </div>
      <form onSubmit={handleSubmit} className="space-y-4 bg-white p-6 rounded-xl shadow border">
        {tab === 'events' && (
          <div>
            <label className="block mb-1 font-semibold">මාතෘකාව</label>
            <input type="text" value={title} onChange={(e) => setTitle(e.target.value)} required className="w-full p-2 border rounded" />
          </div>
        )}
        <div>
          <label className="block mb-1 font-semibold">දිනය</label>
          <input type="date" value={date} onChange={(e) => setDate(e.target.value)} required className="w-full p-2 border rounded" />
        </div>
        <div>
          <label className="block mb-1 font-semibold">විස්තරය / පණිවිඩය</label>
          <textarea value={msg} onChange={(e) => setMsg(e.target.value)} required rows={4} className="w-full p-2 border rounded" />
        </div>
        <button type="submit" className="w-full bg-green-600 text-white py-2 rounded font-bold">පළ කරන්න</button>
      </form>
    </main>
  );
}